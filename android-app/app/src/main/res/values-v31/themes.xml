<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash first; colour it to match ours so it hands over seamlessly -->
    <style name="Theme.ShirurExpress.Splash" parent="Theme.ShirurExpress">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_top</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
