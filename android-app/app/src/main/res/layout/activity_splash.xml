<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- Logo stack: soft glow, two pulsing rings and the round logo -->
    <FrameLayout
        android:id="@+id/splashLogoContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <View
            android:id="@+id/splashGlow"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_glow" />

        <View
            android:id="@+id/splashRing1"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_ring" />

        <View
            android:id="@+id/splashRing2"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_ring" />

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/splash_logo_bg"
            android:contentDescription="@string/app_name"
            android:elevation="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/splashAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splashLogoContainer" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0"
        android:paddingHorizontal="24dp"
        android:gravity="center"
        android:text="@string/splash_tagline"
        android:textColor="@color/splash_tagline"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splashAppName" />

    <!-- Loading bar: a white highlight sweeping along a faint track -->
    <FrameLayout
        android:id="@+id/splashBar"
        android:layout_width="140dp"
        android:layout_height="4dp"
        android:layout_marginBottom="88dp"
        android:alpha="0"
        android:background="@drawable/splash_bar_track"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/splashBarIndicator"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/splash_bar_indicator" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
