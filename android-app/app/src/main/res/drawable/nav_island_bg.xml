<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted pill behind the bottom tabs. The fill is replaced in code with the
     page's background colour, mostly see-through (see BottomNavBar.kt). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#C8FFFFFF" />
    <corners android:radius="28dp" />
    <!-- A faint edge instead of an elevation shadow, which would show grey
         through the see-through fill. -->
    <stroke android:width="1dp" android:color="#240F172A" />
</shape>
